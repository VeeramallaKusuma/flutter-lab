import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';

void main() {
  runApp(const WaterTrackerApp());
}

// ======================================================
// MAIN APP
// ======================================================

class WaterTrackerApp extends StatelessWidget {
  const WaterTrackerApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Smart Water Tracker',
      theme: ThemeData(
        primarySwatch: Colors.blue,
        useMaterial3: true,
      ),
      home: const HomeScreen(),
    );
  }
}

// ======================================================
// HOME SCREEN
// ======================================================

class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  // Total water consumed
  int waterConsumed = 0;

  // Daily goal
  int dailyGoal = 2000;

  // Number of entries
  int entryCount = 0;

  // Controller for water input
  final TextEditingController waterController = TextEditingController();

  @override
  void initState() {
    super.initState();

    loadData();
  }

  Future<void> loadData() async {
    final prefs = await SharedPreferences.getInstance();

    setState(() {
      waterConsumed = prefs.getInt('waterConsumed') ?? 0;

      dailyGoal = prefs.getInt('dailyGoal') ?? 2000;

      entryCount = prefs.getInt('entryCount') ?? 0;
    });
  }


  Future<void> addWater() async {
    // Get input
    String input = waterController.text.trim();

    // Convert input to integer
    int? amount = int.tryParse(input);
    if (amount == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'Please enter a valid number.',
          ),
        ),
      );

      return;
    }

    // Prevent zero and negative values
    if (amount <= 0) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'Water amount must be greater than 0 mL.',
          ),
        ),
      );

      return;
    }
    final prefs = await SharedPreferences.getInstance();

    setState(() {
      waterConsumed += amount;

      entryCount++;
    });

    await prefs.setInt(
      'waterConsumed',
      waterConsumed,
    );

    await prefs.setInt(
      'entryCount',
      entryCount,
    );

    // Clear input field
    waterController.clear();

    // Show success message
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(
          '$amount mL added successfully!',
        ),
      ),
    );
  }
  Future<void> resetWater() async {
    // Show confirmation dialog
    bool? confirm = await showDialog<bool>(
      context: context,
      builder: (BuildContext context) {
        return AlertDialog(
          title: const Text(
            'Reset Water Intake?',
          ),
          content: const Text(
            'Are you sure you want to reset today\'s water intake?',
          ),
          actions: [
            // Cancel button
            TextButton(
              onPressed: () {
                Navigator.pop(
                  context,
                  false,
                );
              },
              child: const Text(
                'Cancel',
              ),
            ),

            // Reset button
            ElevatedButton(
              onPressed: () {
                Navigator.pop(
                  context,
                  true,
                );
              },
              child: const Text(
                'Reset',
              ),
            ),
          ],
        );
      },
    );

    // If user cancels
    if (confirm != true) {
      return;
    }

    // Get storage
    final prefs = await SharedPreferences.getInstance();

    // Reset values
    setState(() {
      waterConsumed = 0;

      entryCount = 0;
    });

    // Save reset values
    await prefs.setInt(
      'waterConsumed',
      0,
    );

    await prefs.setInt(
      'entryCount',
      0,
    );

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text(
          'Today\'s water intake has been reset.',
        ),
      ),
    );
  }

  Future<void> openGoalScreen() async {
    await Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) {
          return GoalScreen(
            currentGoal: dailyGoal,
          );
        },
      ),
    );

    // Load updated goal
    loadData();
  }

  @override
  Widget build(BuildContext context) {

    int remainingWater = dailyGoal - waterConsumed;

    if (remainingWater < 0) {
      remainingWater = 0;
    }
    double completion = 0;

    if (dailyGoal > 0) {
      completion = (waterConsumed / dailyGoal) * 100;
    }

    // Don't display more than 100%
    if (completion > 100) {
      completion = 100;
    }

    // Progress bar value
    double progress = completion / 100;

    return Scaffold(
   
      appBar: AppBar(
        title: const Text(
          'Smart Water Tracker',
        ),
        centerTitle: true,
        actions: [
          IconButton(
            icon: const Icon(
              Icons.settings,
            ),
            onPressed: openGoalScreen,
          ),
        ],
      ),

      body: SingleChildScrollView(
        child: Padding(
          padding: const EdgeInsets.all(20),
          child: Column(
            children: [
              const SizedBox(height: 10),
              const Icon(
                Icons.water_drop,
                size: 80,
                color: Colors.blue,
              ),

              const SizedBox(height: 10),
              const Text(
                'Total Consumed',
                style: TextStyle(
                  fontSize: 18,
                  color: Colors.grey,
                ),
              ),

              const SizedBox(height: 5),

              Text(
                '$waterConsumed mL',
                style: const TextStyle(
                  fontSize: 36,
                  fontWeight: FontWeight.bold,
                ),
              ),

              Text(
                'Daily Goal: $dailyGoal mL',
                style: const TextStyle(
                  fontSize: 16,
                ),
              ),

              const SizedBox(height: 25),
              LinearProgressIndicator(
                value: progress,
                minHeight: 15,
                borderRadius: BorderRadius.circular(10),
              ),

              const SizedBox(height: 10),

              // Completion percentage
              Text(
                '${completion.toInt()}% Completed',
                style: const TextStyle(
                  fontSize: 20,
                  fontWeight: FontWeight.bold,
                ),
              ),

              const SizedBox(height: 25),

              // ==================================================
              // INFORMATION CARDS
              // ==================================================

              Row(
                children: [
                  // Remaining
                  Expanded(
                    child: Card(
                      child: Padding(
                        padding: const EdgeInsets.all(15),
                        child: Column(
                          children: [
                            const Icon(
                              Icons.water_drop_outlined,
                              color: Colors.blue,
                              size: 30,
                            ),
                            const SizedBox(height: 5),
                            const Text(
                              'Remaining',
                            ),
                            const SizedBox(height: 5),
                            Text(
                              '$remainingWater mL',
                              style: const TextStyle(
                                fontSize: 18,
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),
                  ),

                  const SizedBox(width: 10),

                  // Entries
                  Expanded(
                    child: Card(
                      child: Padding(
                        padding: const EdgeInsets.all(15),
                        child: Column(
                          children: [
                            const Icon(
                              Icons.format_list_numbered,
                              color: Colors.blue,
                              size: 30,
                            ),
                            const SizedBox(height: 5),
                            const Text(
                              'Entries',
                            ),
                            const SizedBox(height: 5),
                            Text(
                              '$entryCount',
                              style: const TextStyle(
                                fontSize: 18,
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),
                  ),
                ],
              ),

              const SizedBox(height: 25),

              // ==================================================
              // ADD WATER
              // ==================================================

              const Align(
                alignment: Alignment.centerLeft,
                child: Text(
                  'Add Water Intake',
                  style: TextStyle(
                    fontSize: 20,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),

              const SizedBox(height: 10),

              // Input field
              TextField(
                controller: waterController,
                keyboardType: TextInputType.number,
                decoration: const InputDecoration(
                  labelText: 'Enter water amount',
                  hintText: 'Example: 250',
                  suffixText: 'mL',
                  prefixIcon: Icon(
                    Icons.local_drink,
                  ),
                  border: OutlineInputBorder(),
                ),
              ),

              const SizedBox(height: 15),

              // Add button
              SizedBox(
                width: double.infinity,
                child: ElevatedButton.icon(
                  onPressed: addWater,
                  icon: const Icon(
                    Icons.add,
                  ),
                  label: const Text(
                    'Add Water',
                  ),
                  style: ElevatedButton.styleFrom(
                    padding: const EdgeInsets.all(15),
                  ),
                ),
              ),

              const SizedBox(height: 15),

              // ==================================================
              // QUICK ADD BUTTONS
              // ==================================================

              Row(
                mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                children: [
                  ElevatedButton(
                    onPressed: () {
                      waterController.text = '250';
                    },
                    child: const Text(
                      '+250 mL',
                    ),
                  ),
                  ElevatedButton(
                    onPressed: () {
                      waterController.text = '500';
                    },
                    child: const Text(
                      '+500 mL',
                    ),
                  ),
                ],
              ),

              const SizedBox(height: 25),

              // ==================================================
              // RESET BUTTON
              // ==================================================

              OutlinedButton.icon(
                onPressed: resetWater,
                icon: const Icon(
                  Icons.refresh,
                ),
                label: const Text(
                  'Reset Today',
                ),
                style: OutlinedButton.styleFrom(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 30,
                    vertical: 12,
                  ),
                ),
              ),

              const SizedBox(height: 20),

              // ==================================================
              // COMPLETION MESSAGE
              // ==================================================

              if (waterConsumed >= dailyGoal)
                const Text(
                  '🎉 Daily water goal completed!',
                  style: TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                  ),
                )
              else
                const Text(
                  'Keep drinking water! 💧',
                  style: TextStyle(
                    fontSize: 16,
                  ),
                ),

              const SizedBox(height: 20),
            ],
          ),
        ),
      ),
    );
  }

  @override
  void dispose() {
    waterController.dispose();

    super.dispose();
  }
}

// ======================================================
// GOAL SCREEN
// ======================================================

class GoalScreen extends StatefulWidget {
  final int currentGoal;

  const GoalScreen({
    super.key,
    required this.currentGoal,
  });

  @override
  State<GoalScreen> createState() => _GoalScreenState();
}

class _GoalScreenState extends State<GoalScreen> {
  late TextEditingController goalController;

  @override
  void initState() {
    super.initState();

    goalController = TextEditingController(
      text: widget.currentGoal.toString(),
    );
  }

  // ======================================================
  // SAVE GOAL
  // ======================================================

  Future<void> saveGoal() async {
    String input = goalController.text.trim();

    int? goal = int.tryParse(input);

    // Validate goal
    if (goal == null || goal <= 0) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'Daily goal must be greater than 0 mL.',
          ),
        ),
      );

      return;
    }

    // Save to local storage
    final prefs = await SharedPreferences.getInstance();

    await prefs.setInt(
      'dailyGoal',
      goal,
    );

    if (!mounted) return;

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text(
          'Daily goal updated successfully!',
        ),
      ),
    );

    Navigator.pop(context);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Set Daily Goal',
        ),
      ),
      body: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          children: [
            const SizedBox(height: 30),
            const Icon(
              Icons.water_drop,
              size: 90,
              color: Colors.blue,
            ),
            const SizedBox(height: 30),
            TextField(
              controller: goalController,
              keyboardType: TextInputType.number,
              decoration: const InputDecoration(
                labelText: 'Daily Water Goal',
                hintText: 'Example: 2000',
                suffixText: 'mL',
                prefixIcon: Icon(
                  Icons.flag,
                ),
                border: OutlineInputBorder(),
              ),
            ),
            const SizedBox(height: 20),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton(
                onPressed: saveGoal,
                child: const Text(
                  'Save Goal',
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  @override
  void dispose() {
    goalController.dispose();

    super.dispose();
  }
}
